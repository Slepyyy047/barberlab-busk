# Local data path defaults to ./data. For production, mount a persistent volume here.
# BARBERLAB_DATA_DIR=/var/lib/barberlab
# Set the real HTTPS origin before external access to the admin panel.
# Without BARBERLAB_APP_ORIGIN, admin mutations accept only loopback origins.
# Preview remains noindex until explicitly changed.
# BARBERLAB_PUBLIC_URL=https://your-confirmed-domain.example
# BARBERLAB_APP_ORIGIN=https://your-confirmed-domain.example
# Enable only after the owner authorizes public launch and facts are confirmed:
# BARBERLAB_ALLOW_INDEXING=true
